# ── Database ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster/db?retryWrites=true&w=majority

# ── Server ───────────────────────────────────────────────
PORT=8081
NODE_ENV=production

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me

# ── Email (existing Gmail SMTP via nodemailer) ───────────
EMAIL_USER=your@gmail.com
EMAIL_PASS=app_specific_password
FROM_NAME=Salon Master
EMAIL_MODE=live            # live | mock  (mock = log only, no real send)

# ── Interested Notification Worker ───────────────────────
NOTIFICATION_POLL_INTERVAL_MS=2000   # how often worker checks queue
NOTIFICATION_CONCURRENCY=5           # parallel emails per worker tick
NOTIFICATION_MAX_RETRIES=5           # total attempts before failed
NOTIFICATION_STALE_MS=300000         # processing job considered abandoned after 5 min
NOTIFICATION_BASE_BACKOFF_MS=60000   # 1st retry waits 60s, then 120s, 240s...
NOTIFICATION_BACKOFF_JITTER_MS=15000 # random jitter to avoid thundering herd
NOTIFICATION_WORKER_COUNT=1          # PM2 instances (keep 1 on 2vCPU VPS)

# Premium (app-wide, no ads)
RAZORPAY_PREMIUM_WEBHOOK_SECRET=change_me

# AdMob rewarded ads + server-side verification
ADMOB_SSV_ENABLED=true
ADMOB_REWARDED_AD_UNIT_IDS=ca-app-pub-2690214580846656/7937790563
ADMOB_VERIFIER_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
ADMOB_KEY_CACHE_TTL_MS=86400000
ADMOB_SSV_MAX_CALLBACK_AGE_MS=3600000
ADMOB_SSV_DEBUG=false

# Rewarded reward behaviour
AD_REWARD_TTL_MS=600000
AD_REWARD_VERIFIED_TTL_MS=86400000
AD_FREE_VIDEO_ACCESS_TTL_MINUTES=15
AD_REWARD_DAILY_LIMIT=10
AD_REWARD_MAX_PENDING=3
AD_REWARD_CLAIM_REPLAY_MS=600000
AD_REWARD_TIMEZONE=Asia/Kolkata
