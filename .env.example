# ── Database ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster/db?retryWrites=true&w=majority

# ── Server ───────────────────────────────────────────────
PORT=8081
NODE_ENV=production

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me

# ── Email (existing Gmail SMTP via nodemailer) ───────────
EMAIL_USER=your@gmail.com
EMAIL_PASS=app_specific_password
FROM_NAME=Salon Master
EMAIL_MODE=live            # live | mock  (mock = log only, no real send)

# ── Interested Notification Worker ───────────────────────
NOTIFICATION_POLL_INTERVAL_MS=2000   # how often worker checks queue
NOTIFICATION_CONCURRENCY=5           # parallel emails per worker tick
NOTIFICATION_MAX_RETRIES=5           # total attempts before failed
NOTIFICATION_STALE_MS=300000         # processing job considered abandoned after 5 min
NOTIFICATION_BASE_BACKOFF_MS=60000   # 1st retry waits 60s, then 120s, 240s...
NOTIFICATION_BACKOFF_JITTER_MS=15000 # random jitter to avoid thundering herd
NOTIFICATION_WORKER_COUNT=1          # PM2 instances (keep 1 on 2vCPU VPS)
